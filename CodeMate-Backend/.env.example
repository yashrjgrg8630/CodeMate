# --- Server ---
NODE_ENV=development
PORT=8787
# Exact origin of the React app (no trailing slash). Used for CORS, CSRF origin checks and OAuth redirects.
FRONTEND_ORIGIN=http://localhost:5173
# Set true only when running behind a reverse proxy you control (reads X-Forwarded-For for rate limiting).
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgresql://codemate:codemate@localhost:5432/codemate?schema=public
# Used by `npm test` (separate database so tests never touch dev data).
TEST_DATABASE_URL=postgresql://codemate:codemate@localhost:5432/codemate_test?schema=public

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# lax works when frontend and API share a site (e.g. localhost:3000 + localhost:8787, or app.x.com + api.x.com).
# Use "none" only for truly cross-site deployments (forces Secure cookies, requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Google OAuth (optional; leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/dashboard
OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model that supports JSON output + code execution. Check the current list in Google AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: separate model for code-execution calls (verification + benchmarks). Defaults to GEMINI_MODEL.
GEMINI_EXEC_MODEL=
# Optional: cap internal "thinking" tokens (Gemini 2.5 models). Blank = model default.
GEMINI_THINKING_BUDGET=
# Standard paid-tier USD per 1M tokens, used only for the cost column in AiCallLog.
# Verify current pricing before deploying: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_COST_PER_MTOK_INPUT=0.75
GEMINI_COST_PER_MTOK_OUTPUT=3.75
AI_TIMEOUT_MS=90000
AI_EXEC_TIMEOUT_MS=120000

# --- Rate limits ---
GENERAL_RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_PER_MIN=10
AI_DAILY_LIMIT=150
